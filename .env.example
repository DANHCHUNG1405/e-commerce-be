# Template only. Copy to .env and fill in your own configuration.
# Never put real credentials, access tokens or cloud connection strings here.
APP_ENV=development
PORT=8080

# Required PostgreSQL connection URL; fill in .env only.
DATABASE_URL=

# Required MongoDB connection URL; fill in .env only.
MONGO_URL=
MONGO_DATABASE=ecommerce

# Required Redis URL; use rediss:// for TLS. Fill in .env only.
# Application keys use the fixed ecommerce: namespace.
REDIS_URL=

# Required: generate a unique random JWT signing secret in .env.
JWT_SECRET=

# Optional SePay: leave all three empty to disable online payment.
# If enabled, set all three in .env; webhook secret must be at least 32 characters.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_SECRET=

# Exact frontend origins for WebSocket, comma-separated. No trailing paths.
WEBSOCKET_ORIGINS=http://localhost:5173
