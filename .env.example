# Template only. Copy to .env and fill in your own configuration.
# Never put real credentials, access tokens or cloud connection strings here.
APP_ENV=development
PORT=8080

# Internal Notification Service HTTP boundary. API proxies public notification routes here.
NOTIFICATION_SERVICE_URL=http://notification:8082
NOTIFICATION_PORT=8082

# Internal Chat Service boundaries. API translates REST to gRPC and proxies WebSocket here.
CHAT_SERVICE_URL=http://chat:8083
CHAT_GRPC_TARGET=chat:9091
CHAT_HTTP_PORT=8083
CHAT_GRPC_PORT=9091

# Required PostgreSQL connection URL; fill in .env only.
DATABASE_URL=

# Required MongoDB connection URL; fill in .env only.
MONGO_URL=
MONGO_DATABASE=ecommerce

# Required Redis URL; use rediss:// for TLS. Fill in .env only.
# Application keys use the fixed ecommerce: namespace.
REDIS_URL=

# Required: generate a unique random JWT signing secret in .env.
JWT_SECRET=

# Optional SePay: leave all three empty to disable online payment.
# If enabled, set all three in .env; webhook secret must be at least 32 characters.
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=
SEPAY_WEBHOOK_SECRET=

# Exact frontend origins for WebSocket, comma-separated. No trailing paths.
WEBSOCKET_ORIGINS=http://localhost:5173

# Password reset email provider (SMTP). Required to enable forgot-password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Kafka-compatible broker used by the outbox relay.
KAFKA_BROKERS=kafka:9092
KAFKA_NOTIFICATION_DLQ_TOPIC=ecommerce.notification.dlq.v1
